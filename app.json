{
  "expo": {
    "name": "ぬいぐるみ合成カメラ",
    "slug": "stuffed-cam",
    "version": "1.0.0",
    "scheme": "stuffedcam",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.stuffedcam"
    },
    "android": {
      "package": "com.example.stuffedcam",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1a1a1a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "cmakeVersion": "3.31.6",
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "合成結果を端末に保存するために写真へのアクセスを許可してください",
          "savePhotosPermission": "合成結果をギャラリーに保存するために許可してください",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ギャラリーから画像を選ぶために許可してください"
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111111",
          "image": "./assets/icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
